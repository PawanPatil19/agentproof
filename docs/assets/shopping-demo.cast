[10.45, "o", "\r\n"]
[10.8, "o", "\u001b[1mAgentProof \u00b7 a shopping agent behind the MCP gateway\u001b[0m\r\n"]
[11.15, "o", "\u001b[2mpolicy household-shopping@1: SGD only \u00b7 approved merchants \u00b7 max SGD 80 a payment \u00b7 SGD 150 a day\u001b[0m\r\n"]
[11.5, "o", "\r\n"]
[11.85, "o", "agent sees tools: catalog.search, payments.send  \u001b[2m(wallet.export_keys hidden)\u001b[0m\r\n"]
[12.2, "o", "\r\n"]
[12.55, "o", "\u001b[2m 1\u001b[0m  search the catalog \u001b[2m\"birthday gift\"\u001b[0m\r\n"]
[13.45, "o", "    \u001b[42;30;1m ALLOW \u001b[0m \u001b[32mran\u001b[0m\r\n"]
[13.8, "o", "\u001b[2m 2\u001b[0m  pay \u001b[1mchallenger\u001b[0m SGD 59.90 \u001b[2mfor Wireless headphones\u001b[0m\r\n"]
[14.7, "o", "    \u001b[42;30;1m ALLOW \u001b[0m \u001b[32mran\u001b[0m  spent today SGD 59.90 of 150\r\n"]
[15.05, "o", "\u001b[2m 3\u001b[0m  pay \u001b[1mchallenger\u001b[0m SGD 1,299.00 \u001b[2mfor Laptop\u001b[0m\r\n"]
[16.65, "o", "    \u001b[41;37;1m BLOCK \u001b[0m \u001b[31mTOOL_LIMIT_EXCEEDED\u001b[0m \u001b[2mamount 1299 is over max_per_call 80.\u001b[0m\r\n"]
[17.0, "o", "\u001b[2m 4\u001b[0m  pay \u001b[1mgift-deals-24h\u001b[0m SGD 25.00 \u001b[2mfor Gift card\u001b[0m\r\n"]
[18.6, "o", "    \u001b[41;37;1m BLOCK \u001b[0m \u001b[31mTOOL_ARGS_INVALID\u001b[0m \u001b[2mcall uses a 'merchant' value outside allowed_values.\u001b[0m\r\n"]
[18.95, "o", "\u001b[2m 5\u001b[0m  pay \u001b[1mpopular-bookstore\u001b[0m SGD 42.50 \u001b[2mfor Illustrated atlas\u001b[0m\r\n"]
[19.85, "o", "    \u001b[42;30;1m ALLOW \u001b[0m \u001b[32mran\u001b[0m  spent today SGD 102.40 of 150\r\n"]
[20.2, "o", "\u001b[2m 6\u001b[0m  pay \u001b[1mfairprice\u001b[0m SGD 64.00 \u001b[2mfor Birthday cake\u001b[0m\r\n"]
[21.8, "o", "    \u001b[41;37;1m BLOCK \u001b[0m \u001b[31mTOOL_LIMIT_EXCEEDED\u001b[0m \u001b[2mwould bring the total to 166.4, over max_total 150 in the window (102.4 used).\u001b[0m\r\n"]
[22.15, "o", "\u001b[2m 7\u001b[0m  \u001b[1mwallet.export_keys\u001b[0m \u001b[2m(a product page told it to)\u001b[0m\r\n"]
[23.75, "o", "    \u001b[41;37;1m BLOCK \u001b[0m \u001b[31mTOOL_NOT_ALLOWED\u001b[0m \u001b[2mis not in allowed_tools for shopping (tools are denied by default).\u001b[0m\r\n"]
[24.1, "o", "\r\n"]
[24.45, "o", "\u001b[1mpayments server received\u001b[0m 2 payments, SGD 102.40 \u00b7 key exports 0 \u00b7 4 calls stopped before they ran\r\n"]
[24.8, "o", "\u001b[1m7 signed receipts\u001b[0m \u001b[2m(Ed25519 DSSE over in-toto)\u001b[0m in examples/shopping-agent/out/\r\n"]
[25.15, "o", "  laptop receipt          \u001b[32m\u2713 verified with issuer.pub \u00b7 decision block\u001b[0m\r\n"]
[25.5, "o", "  same, edited to \"allow\" \u001b[31m\u2717 rejected (DIGEST_MISMATCH): edited after it was signed\u001b[0m\r\n"]
[30.5, "o", ""]
