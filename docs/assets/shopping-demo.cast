[3.59, "o", "\r\n"]
[3.65, "o", "contracts:\r\n"]
[3.71, "o", "  shopping:\r\n"]
[3.77, "o", "    version: 1\r\n"]
[3.83, "o", "    coordinator: household\r\n"]
[3.89, "o", "    worker: shopper\r\n"]
[3.95, "o", "    deadline_ms: 30000         # per call\r\n"]
[4.01, "o", "    allowed_tools: [catalog.search, payments.send]   # wallet.export_keys is denied by default\r\n"]
[4.07, "o", "    tool_constraints:\r\n"]
[4.13, "o", "      payments.send:\r\n"]
[4.19, "o", "        args_schema:\r\n"]
[4.25, "o", "          type: object\r\n"]
[4.31, "o", "          required: [merchant, amount, currency, item]\r\n"]
[4.37, "o", "          additionalProperties: false\r\n"]
[4.43, "o", "          properties:\r\n"]
[4.49, "o", "            merchant: { type: string }\r\n"]
[4.55, "o", "            amount: { type: number }\r\n"]
[4.61, "o", "            currency: { type: string }\r\n"]
[4.67, "o", "            item: { type: string }\r\n"]
[4.73, "o", "        allowed_values:\r\n"]
[4.79, "o", "          currency: [SGD]\r\n"]
[4.85, "o", "          merchant: [challenger, popular-bookstore, fairprice]\r\n"]
[4.91, "o", "        amount_field: amount\r\n"]
[4.97, "o", "        max_per_call: 80       # SGD per payment\r\n"]
[5.03, "o", "        max_total: 150         # SGD per rolling day, across every call this agent makes\r\n"]
[5.09, "o", "        max_calls: 5\r\n"]
[5.15, "o", "        window_ms: 86400000\r\n"]
[8.65, "o", ""]
[8.75, "o", "\u001b[2J\u001b[H"]
[8.95, "o", "\u001b[2m# Now the agent shops. It is a plain MCP client; the gateway decides every call.\u001b[0m\r\n"]
[9.35, "o", "\u001b[1;32m$\u001b[0m "]
[9.385, "o", "n"]
[9.42, "o", "p"]
