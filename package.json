{
  "name": "agentproof-monorepo",
  "private": true,
  "type": "module",
  "description": "Evidence-backed answers and enforceable agent-to-agent contracts.",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/core",
    "packages/sdk",
    "packages/cli",
    "packages/judge-anthropic",
    "packages/mcp-gateway",
    "examples/research-handoff"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --pretty",
    "test": "node --experimental-strip-types --no-warnings --conditions=source --test \"packages/*/test/*.test.ts\" \"examples/*/test/*.test.ts\"",
    "demo": "node --experimental-strip-types --no-warnings --conditions=source examples/research-handoff/src/run.ts",
    "bench": "node --experimental-strip-types --no-warnings --conditions=source scripts/bench.ts",
    "agentproof": "node --experimental-strip-types --no-warnings --conditions=source packages/cli/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "typescript": "5.9.3"
  }
}
